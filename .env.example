# Canonical production origin, no trailing slash. Used for canonical URLs,
# Open Graph URLs, the sitemap and robots.txt. Confirm before going live.
VITE_SITE_URL=https://www.visa2grow.com

# Where the project inquiry form POSTs JSON. Default: /api/inquiry (the
# serverless function in api/inquiry.ts). Set to "none" on a host without
# serverless functions; the form then offers email instead.
VITE_CONTACT_ENDPOINT=

# Public inbox shown in the footer, contact page and privacy notice, and used
# as the mailto fallback when the form endpoint is missing or fails.
# Defaults to sales@visa2grow.com; set this only to override it.
VITE_CONTACT_EMAIL=

# Set to "true" on staging/preview deployments to emit noindex on every page
# and a disallow-all robots.txt.
VITE_NOINDEX=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY (never prefix with VITE_). Set these in Vercel → Project →
# Settings → Environment Variables, and in .env.local for `npm run dev`.
# ---------------------------------------------------------------------------
# Resend API key. A "Sending access" key restricted to the visa2grow.com domain is enough.
RESEND_API_KEY=
# Inbox that receives new inquiries.
INQUIRY_NOTIFICATION_EMAIL=sales@visa2grow.com
# Verified sender. Must be on a domain verified in Resend.
INQUIRY_FROM_EMAIL=Visa2Grow Website <inquiries@visa2grow.com>
# Optional: canonical origin (defaults to https://www.visa2grow.com; the bare domain is allowed too)
# and extra origins allowed to POST, comma-separated.
SITE_URL=
INQUIRY_ALLOWED_ORIGINS=
